# Environment
ENVIRONMENT=development

# Database Configuration
# For local development with Docker:
DATABASE_URL=postgresql+asyncpg://simulab:simulab@localhost:5432/simulab
# For Docker Compose (service name resolution):
# DATABASE_URL=postgresql+asyncpg://simulab:simulab@postgres:5432/simulab

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis
REDIS_URL=redis://localhost:6379
# For Docker Compose:
# REDIS_URL=redis://redis:6379

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Git
GIT_REPOS_PATH=/var/lib/simulab/repos

# Logging
LOG_LEVEL=INFO
